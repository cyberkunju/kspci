{
    "deployment": {
        "name": "api",
        "stack": "node18",
        "type": "advancedio",
        "memory": 1024,
        "env_variables": {
            "ADMIN_KEY": "<set-a-strong-admin-key>",

            "LLM_PROVIDER": "quickml",

            "//": "--- Zoho Catalyst QuickML LLM Serving — GLM-4.7-Flash ---",
            "QUICKML_LLM_ENDPOINT": "https://api.catalyst.zoho.in/quickml/v1/project/<PROJECT_ID>/glm/chat",
            "QUICKML_MODEL": "crm-di-glm47b_30b_it",
            "QUICKML_THINKING": "false",
            "QUICKML_ORG_ID": "<your-catalyst-org-id>",
            "ZOHO_CLIENT_ID": "<self-client-id>",
            "ZOHO_CLIENT_SECRET": "<self-client-secret>",
            "ZOHO_REFRESH_TOKEN": "<refresh-token-with-QuickML.deployment.READ-scope>",
            "ZOHO_ACCOUNTS_URL": "https://accounts.zoho.in",

            "//voice": "--- Sarvam AI (voice STT/TTS — Catalyst has no speech model) ---",
            "SARVAM_API_KEY": "<your-sarvam-api-key>",
            "SARVAM_STT_MODEL": "saarika:v2.5",
            "SARVAM_TTS_MODEL": "bulbul:v3",
            "SARVAM_TTS_SPEAKER": "ritu",

            "//wa": "--- WhatsApp field-officer channel (Meta Cloud API) ---",
            "WA_PHONE_NUMBER_ID": "<whatsapp-business-phone-number-id>",
            "WA_ACCESS_TOKEN": "<permanent-system-user-access-token>",
            "WA_APP_SECRET": "<meta-app-secret-used-to-verify-webhook-signatures>",
            "WA_VERIFY_TOKEN": "<random-string-you-also-paste-into-the-meta-webhook-form>",
            "WA_GRAPH_VERSION": "v25.0",
            "WA_HTTP_TIMEOUT_MS": "20000",

            "//wa2": "--- Async processing: Catalyst Job Scheduling (webhook job pool) ---",
            "WA_JOBPOOL": "<webhook-jobpool-name>",
            "WA_PROCESS_URL": "https://<your-domain>/server/api/whatsapp/process",
            "WA_INTERNAL_KEY": "<strong-random-key-guarding-/whatsapp/process-and-alert-dispatch>",

            "//wa3": "--- Proactive alerts (template required outside the 24h window) ---",
            "WA_ALERT_TEMPLATE": "ksp_early_warning",
            "WA_ALERT_TEMPLATE_LANG": "en",
            "WA_ALERT_MAX_SENDS": "200",

            "//wa4": "--- Field photo gallery + Zia facial comparison tuning ---",
            "WA_PHOTO_BUCKET": "ksp-field-photos",
            "WA_FACE_CANDIDATES": "12",
            "WA_FACE_CONCURRENCY": "3",
            "WA_RATE_LIMIT": "60",
            "WA_AGENT_STEPS": "6",
            "WA_VOICE_REPLY": "on",

            "//research": "--- OSINT research engine (AppSail service in research/) ---",
            "//research1": "A run takes 40-300s and this function is killed at 30, so it starts runs there and polls.",
            "RESEARCH_SERVICE_URL": "https://<research-appsail-app>.development.catalystappsail.in",
            "RESEARCH_INTERNAL_KEY": "<same-strong-key-set-as-RESEARCH_INTERNAL_KEY-on-the-appsail-service>",
            "RESEARCH_START_TIMEOUT_MS": "15000",
            "RESEARCH_POLL_TIMEOUT_MS": "20000",
            "//research2": "Where the engine POSTs a finished run so WhatsApp can be told. Defaults to WA_PROCESS_URL's host + /research/callback.",
            "RESEARCH_CALLBACK_URL": "https://<your-domain>/server/api/research/callback",

            "//3": "--- Optional tuning ---",
            "LLM_TIMEOUT_MS": "60000",
            "LLM_FORCE_REACT": "false",
            "FORECAST_SERVICE_URL": "https://<your-appsail-app>.development.catalystappsail.in"
        }
    },
    "execution": {
        "main": "index.js"
    }
}
