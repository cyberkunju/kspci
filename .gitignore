# Dependencies
node_modules/
**/node_modules/

# Build output
client/dist/
.output/

# Catalyst
.catalyst/
catalyst-cli.log

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Catalyst function config carries real API keys — keep out of the repo.
# Use catalyst-config.example.json as the template (placeholders only).
functions/api/catalyst-config.json

# Synthetic data (regenerated via script)
datastore/seed/*.csv
datastore/train/*.csv
# Loader resume checkpoint
datastore/seed/.load-state.json

# Raw open-data inputs for build-geo.js (~57MB; refetch via datastore/fetch-geo.sh)
datastore/raw/
# Locality table derived from those inputs (9MB; generator-only, rebuilt by build-geo.js)
datastore/ref/india_localities.json

# ML pipeline (local training on GPU; large artifacts)
ml/.venv/
ml/data/
ml/models/
**/__pycache__/
*.parquet

# Vendored Linux wheels for the AppSail Python service (~200MB; reinstall via pip/requirements)
ml/service/vendor/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.log

# Local browser-automation (Playwright MCP) artifacts — snapshots, console logs
.playwright-mcp/

# Source PDF (confidential reference, not for repo)
Police_FIR_ER_Diagram.pdf

# AppSail build artefacts: vendored wheels (~200MB) and the engine copy, both regenerated
# by ml/service/deploy.sh from ml/engine and requirements.txt.
ml/service/vendor/
ml/service/engine/
